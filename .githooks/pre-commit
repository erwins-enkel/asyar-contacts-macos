#!/bin/sh
# Last line of defence against real personal data entering the repository.
#
# The mistake that made this hook necessary was a commit, not a failing build.
# So the check runs here, before anything reaches the history — where it could
# only be removed again by rewriting it.
#
# Enable once:  git config core.hooksPath .githooks
exec node scripts/check-no-personal-data.mjs
